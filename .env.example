# Required: set this to your MongoDB Atlas connection string.
MONGODB_URI=
# Optional: defaults to tiffintrack.
MONGODB_DB=tiffintrack
# Required for auth; use a unique random value with at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Recommended for local development.
BETTER_AUTH_URL=http://localhost:3000
# Required for email OTP delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
